version: 0.2

minGameVersion: 158

java: true

hideBrowser: false

# ALL VARIABLES BELOW ONLY EXIST DURING COMPILE TIME

# target release group
# prealpha - usable, unstable, but awaits community input
# alpha - usable, features missing
# beta - features implemented, bug testing at work
# release - features implemented, all bugs are probably fixed
# patch - resolve bugs and/or perform various tweaks after release build
group: "prealpha"
# build index, ignored for release groups
build: 2
